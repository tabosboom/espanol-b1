{
 "id": "g1",
 "title": "Verbs + prepositions",
 "rule": {
  "intro": "Many Spanish verbs take a fixed preposition. Learn the verb and its preposition as one unit. People as direct objects take «a».",
  "points": [
   {
    "title": "con",
    "examples": [
     [
      "soñar con, casarse con, contar con",
      "dream about, marry, count on"
     ],
     [
      "Estoy de acuerdo con esa decisión.",
      "I agree with that decision."
     ]
    ]
   },
   {
    "title": "en",
    "examples": [
     [
      "pensar en, confiar en, fijarse en, tardar en",
      "think about, trust, notice, take time to"
     ],
     [
      "Estamos interesados en alquilar un piso.",
      "We are interested in renting a flat."
     ]
    ]
   },
   {
    "title": "de",
    "examples": [
     [
      "depender de, acordarse de, olvidarse de, dejar de",
      "depend on, remember, forget, stop doing"
     ],
     [
      "No me di cuenta de la hora.",
      "I didn't notice the time."
     ]
    ]
   },
   {
    "title": "a",
    "examples": [
     [
      "aprender a, empezar a, ayudar a, volver a, ir a",
      "learn to, start to, help to, do again, going to"
     ],
     [
      "Llegué a casa muy tarde.",
      "I got home very late."
     ]
    ]
   },
   {
    "title": "por",
    "examples": [
     [
      "preocuparse por, interesarse por",
      "worry about, take an interest in"
     ],
     [
      "Salgo a correr por la mañana.",
      "I go running in the morning."
     ]
    ]
   },
   {
    "title": "Personal «a»",
    "examples": [
     [
      "He conocido a otras personas.",
      "I've met other people."
     ],
     [
      "Ayer vi a Marta.",
      "I saw Marta yesterday."
     ]
    ]
   }
  ],
  "watch": "From your exam: interesados en (not de), soñé con (not para), de acuerdo con (not para), aprender a (not de)."
 },
