{
 "id": "g3",
 "title": "Imperative",
 "rule": {
  "intro": "Your tú and vosotros commands are fine. Practise the usted forms. They use the subjunctive endings, and reflexive pronouns go on the end of positive commands and before negative ones.",
  "points": [
   {
    "title": "Usted",
    "examples": [
     [
      "Complete, Utilice, Coja, Venga",
      "-ar takes -e; -er and -ir take -a"
     ],
     [
      "No utilice, No complete",
      "the negative has the same form"
     ]
    ]
   },
   {
    "title": "Usted with a reflexive",
    "examples": [
     [
      "Siéntese, Preocúpese",
      "positive: pronoun on the end, plus accent"
     ],
     [
      "No se siente, No se preocupe",
      "negative: pronoun in front"
     ]
    ]
   },
   {
    "title": "Tú and vosotros",
    "examples": [
     [
      "Habla, Come, Ven, Haz, Sal",
      "positive tú"
     ],
     [
      "No hables, No vengas",
      "negative tú uses the subjunctive"
     ],
     [
      "Hablad, Venid; No habléis",
      "vosotros"
     ]
    ]
   },
   {
    "title": "Pronouns",
    "examples": [
     [
      "Dímelo, Tráigamelo",
      "positive: joined on the end"
     ],
     [
      "No me lo digas",
      "negative: in front"
     ]
    ]
   }
  ],
  "watch": "From your exam: Completa → Complete, No utilize → No utilice, Utiliza → Utilice, No preocupese → No se preocupe, Preocupase → Preocúpese."
 },
