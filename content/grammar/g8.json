{
 "id": "g8",
 "title": "B1 extras",
 "rule": {
  "intro": "Four things B1 expects: object pronouns, verbs that work like gustar, comparisons, and «si» sentences.",
  "points": [
   {
    "title": "Pronouns",
    "examples": [
     [
      "Lo veo. La veo.",
      "direct object: lo, la, los, las"
     ],
     [
      "Le doy el libro.",
      "indirect object: le, les"
     ],
     [
      "Se lo doy.",
      "le + lo becomes se lo"
     ]
    ]
   },
   {
    "title": "Like gustar",
    "examples": [
     [
      "Me gusta ver películas.",
      "one thing or an infinitive"
     ],
     [
      "Me gustan las películas.",
      "plural: gustan"
     ],
     [
      "Me preocupa, me molesta, me apetece, me parece",
      "same pattern"
     ]
    ]
   },
   {
    "title": "Comparing",
    "examples": [
     [
      "más alto que; menos caro que",
      "more, less"
     ],
     [
      "tan alto como",
      "as … as"
     ],
     [
      "el más alto de",
      "the most … of"
     ],
     [
      "mejor, peor, mayor, menor",
      "irregular"
     ]
    ]
   },
   {
    "title": "Si sentences",
    "examples": [
     [
      "Si tengo tiempo, iré.",
      "a real possibility"
     ],
     [
      "Me gustaría ir.",
      "conditional: wishes, polite requests"
     ],
     [
      "Si tuviera tiempo, iría.",
      "imagined"
     ]
    ]
   }
  ],
  "watch": "From your exam: me gusta ver películas, not quiero ver películas, when you mean you like it."
 },
