{
 "id": "g2",
 "title": "Present subjunctive",
 "rule": {
  "intro": "You choose the subjunctive correctly. The forms are the weak point. Start from the yo form of the present, drop -o, and swap the ending: -ar verbs take -e, -er and -ir verbs take -a.",
  "points": [
   {
    "title": "Regular",
    "examples": [
     [
      "hablar → hable, hables, hable, hablemos, habléis, hablen",
      "-ar takes -e"
     ],
     [
      "comer → coma; vivir → viva",
      "-er and -ir take -a"
     ]
    ]
   },
   {
    "title": "Stem changes",
    "examples": [
     [
      "encontrar → encuentre; poder → pueda",
      "o→ue"
     ],
     [
      "llover → llueva",
      "o→ue, -er takes -a"
     ],
     [
      "pensar → piense; pedir → pida",
      "e→ie, e→i"
     ]
    ]
   },
   {
    "title": "-zc- and -g- verbs",
    "examples": [
     [
      "conocer → conozca; conducir → conduzca",
      "yo conozco keeps its zc"
     ],
     [
      "tener → tenga; venir → venga; hacer → haga",
      "yo tengo keeps its g"
     ]
    ]
   },
   {
    "title": "Spelling changes",
    "examples": [
     [
      "buscar → busque; llegar → llegue; utilizar → utilice",
      "c→qu, g→gu, z→c"
     ],
     [
      "enviar → envíe",
      "keeps the accent on í"
     ]
    ]
   },
   {
    "title": "Irregulars",
    "examples": [
     [
      "ser → sea; estar → esté; ir → vaya",
      "learn these six"
     ],
     [
      "saber → sepa; haber → haya; dar → dé",
      "learn these six"
     ]
    ]
   },
   {
    "title": "When to use it",
    "examples": [
     [
      "Quiero que vengas.",
      "wish, with a new subject"
     ],
     [
      "Creo que viene.",
      "creo que takes the indicative"
     ],
     [
      "Quiero venir.",
      "same subject takes the infinitive"
     ]
    ]
   }
  ],
  "watch": "From your exam: conocan → conozcan, encontré → encuentre, envié → envíe, llova → llueva."
 },
